# ---- Local development database (Docker Postgres) ----
DATABASE_URL="postgresql://tradedemo:tradedemo-local@localhost:5432/tradedemo?schema=public"

# ---- Supabase (production / Vercel) ----
# Get the connection string from Supabase Dashboard → Project Settings →
# Database → Connection string → "Session pooler" (URI). Fill in the database
# password when you create/reset it. Use <db-password> beneath a SUPPORT HOST.
# Postgres host is <ref>.pooler.supabase.com on port 5432 (session pooler),
# which Prisma supports without extra flags.
# On Vercel set DATABASE_URL (and optional DIRECT_URL) to the same value.
#SUPABASE_DATABASE_URL="postgresql://postgres.idszintwrslhuxnwnqlt:<DB_PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres"
DIRECT_URL=""

# Live region for the API (used by the Supabase SDK / Realtime if wired later).
# The current app talks to the database through Prisma, not the REST API.
NEXT_PUBLIC_SUPABASE_URL="https://idszintwrslhuxnwnqlt.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_<your-publishable-key>"
SUPABASE_SERVICE_ROLE_KEY="<your-service-role-jwt>"

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Email verification is optional for virtual demo accounts. Set to "true"
# only after configuring an email provider and HTTPS application URL.
EMAIL_VERIFICATION_REQUIRED="false"
RESEND_API_KEY=""
EMAIL_FROM="TradeDemo <accounts@example.com>"

# Configure with: openssl rand -hex 32
# Required only when a user enables authenticator-based 2FA.
TOTP_ENCRYPTION_KEY=""

# Optional licensed market-data adapter. Unset means clearly labelled simulated data.
MARKET_DATA_URL=""
MARKET_DATA_API_KEY=""

# Payment mode. "simulated" (default) instantly completes deposits/withdrawals
# against the real (sandbox) balance pool for demos and presentations.
# Use "daraja" when the organization's Safaricom sandbox credentials are added
# (still sandbox-only — no real money moves).
PAYMENT_PROVIDER="simulated"
PAYMENTS_ENABLED="true"

# Optional Safaricom Daraja SANDBOX integration (no real funds move).
# Used only when PAYMENT_PROVIDER="daraja". MPESA_BASE_URL must stay on the
# sandbox host.
MPESA_BASE_URL="https://sandbox.safaricom.co.ke"
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_SHORTCODE="174379"
MPESA_PASSKEY=""
MPESA_CALLBACK_URL="http://localhost:3000/api/payments/callback"
MPESA_INITIATOR_NAME=""
MPESA_INITIATOR_PASSWORD=""
MPESA_B2C_RESULT_URL="http://localhost:3000/api/payments/callback"